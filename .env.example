# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# These are safe to expose in client-side code: VITE_SUPABASE_ANON_KEY is the
# public "anon" key, meant to be used from the browser. Access to data is
# controlled by the Row Level Security policies in supabase/migrations, not
# by keeping this key secret.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
